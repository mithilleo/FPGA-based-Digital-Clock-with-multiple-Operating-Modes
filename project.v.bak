module project (
    input  wire       clk,        // 50 MHz DE2-115 clock
    input  wire       rst_n,      // Active-low asynchronous reset (e.g., KEY0)
    output wire [6:0] seg_hr_tens,  // Most significant hour digit
    output wire [6:0] seg_hr_ones,  // Least significant hour digit
    output wire [6:0] seg_min_tens, // Most significant minute digit
    output wire [6:0] seg_min_ones  // Least significant minute digit
);

    // -------------------------------------------------------------
    // 1-Hz Tick Generator: Divide 50 MHz down to 1 Hz
    // 50,000,000 cycles = 1 second -> count from 0 to 49,999,999
    // -------------------------------------------------------------
    reg [25:0] tick_counter;
    reg        one_sec_tick;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            tick_counter <= 26'd0;
            one_sec_tick <= 1'b0;
        end else if (tick_counter == 26'd49_999_999) begin
            tick_counter <= 26'd0;
            one_sec_tick <= 1'b1;
        end else begin
            tick_counter <= tick_counter + 1'b1;
            one_sec_tick <= 1'b0;
        end
    end

    // -------------------------------------------------------------
    // Time Keeping Logic: Seconds (00-59), Minutes (00-59), Hours (00-23)
    // -------------------------------------------------------------
    reg [5:0] sec;
    reg [5:0] min;
    reg [4:0] hr;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            sec <= 6'd0;
            min <= 6'd0;
            hr  <= 5'd0;
        end else if (one_sec_tick) begin
            if (sec == 6'd59) begin
                sec <= 6'd0;
                if (min == 6'd59) begin
                    min <= 6'd0;
                    if (hr == 5'd23)
                        hr <= 5'd0;
                    else
                        hr <= hr + 1'b1;
                end else begin
                    min <= min + 1'b1;
                end
            end else begin
                sec <= sec + 1'b1;
            end
        end
    end

    // -------------------------------------------------------------
    // Binary-to-BCD Conversion (Tens and Ones separation)
    // -------------------------------------------------------------
    wire [3:0] bcd_min_ones = min % 10;
    wire [3:0] bcd_min_tens = min / 10;
    wire [3:0] bcd_hr_ones  = hr % 10;
    wire [3:0] bcd_hr_tens  = hr / 10;

    // -------------------------------------------------------------
    // 7-Segment Decoder Instances
    // -------------------------------------------------------------
    seven_seg_decoder dec_m0 (.bcd(bcd_min_ones), .seg(seg_min_ones));
    seven_seg_decoder dec_m1 (.bcd(bcd_min_tens), .seg(seg_min_tens));
    seven_seg_decoder dec_h0 (.bcd(bcd_hr_ones),  .seg(seg_hr_ones));
    seven_seg_decoder dec_h1 (.bcd(bcd_hr_tens),  .seg(seg_hr_tens));

endmodule

// -------------------------------------------------------------
// Active-low 7-Segment Decoder (g, f, e, d, c, b, a)
// 0 = Segment ON, 1 = Segment OFF
// -------------------------------------------------------------
module seven_seg_decoder (
    input  wire [3:0] bcd,
    output reg  [6:0] seg
);
    always @(*) begin
        case (bcd)
            4'd0: seg = 7'b0111111; // Displays 0
            4'd1: seg = 7'b0000110; // Displays 1
            4'd2: seg = 7'b1011011; // Displays 2
            4'd3: seg = 7'b1001111; // Displays 3
            4'd4: seg = 7'b1100110; // Displays 4
            4'd5: seg = 7'b1101101; // Displays 5
            4'd6: seg = 7'b1111101; // Displays 6
            4'd7: seg = 7'b0000111; // Displays 7
            4'd8: seg = 7'b1111111; // Displays 8
            4'd9: seg = 7'b1101111; // Displays 9
            default: seg = 7'b0000000; // All segments OFF (blank)
        endcase
    end
endmodule